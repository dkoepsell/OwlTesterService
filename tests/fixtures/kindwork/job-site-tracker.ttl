# Job site tracker: ontology generated by Kindwork on 2026-10-18.
# Every class is placed under BFO 2020 (ISO/IEC 21838-2) by the keyword it was given in the interview.
# Import BFO and run an OWL DL reasoner before relying on it (OwlTester does this). Closed-world rules live in the SHACL file.
# kwv: is the shared Kindwork vocabulary read by BFO-Agent and OwlTester.

@prefix : <https://example.org/kindwork/job-site-tracker#> .
@prefix kwv: <https://ontology.davidkoepsell.com/kindwork/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<https://example.org/kindwork/job-site-tracker> a owl:Ontology ;
  rdfs:label "Job site tracker"@en ;
  owl:imports <http://purl.obolibrary.org/obo/bfo.owl> .

kwv:keyword a owl:AnnotationProperty ; rdfs:label "Kindwork keyword"@en .

kwv:heldBy a owl:ObjectProperty ; rdfs:label "held by"@en ; obo:IAO_0000115 "Links a status to whoever holds it."@en .
kwv:issuedBy a owl:ObjectProperty ; rdfs:label "issued by"@en ; obo:IAO_0000115 "Links a status to the authority that granted it."@en .
kwv:canGrant a owl:ObjectProperty ; rdfs:label "can grant"@en ; obo:IAO_0000115 "Links an authority to a kind of status it can grant or revoke."@en .
kwv:owedBy a owl:ObjectProperty ; rdfs:label "owed by"@en ; obo:IAO_0000115 "Links an obligation to whoever must act."@en .
kwv:owedTo a owl:ObjectProperty ; rdfs:label "owed to"@en ; obo:IAO_0000115 "Links an obligation to whoever can claim it."@en .
kwv:marks a owl:ObjectProperty ; rdfs:label "marks"@en ; obo:IAO_0000115 "Links a moment to the happening it starts or ends."@en .

kwv:grantedOn a owl:DatatypeProperty ; rdfs:label "granted on"@en .
kwv:expiresOn a owl:DatatypeProperty ; rdfs:label "expires on"@en .
kwv:standing a owl:DatatypeProperty ; rdfs:label "standing"@en .
kwv:dueOn a owl:DatatypeProperty ; rdfs:label "due on"@en .
kwv:startsAt a owl:DatatypeProperty ; rdfs:label "starts at"@en .
kwv:endsAt a owl:DatatypeProperty ; rdfs:label "ends at"@en .
kwv:occursAt a owl:DatatypeProperty ; rdfs:label "occurs at"@en .
kwv:startsOn a owl:DatatypeProperty ; rdfs:label "starts on"@en .
kwv:endsOn a owl:DatatypeProperty ; rdfs:label "ends on"@en .
kwv:hasValue a owl:DatatypeProperty ; rdfs:label "has value"@en .
kwv:unit a owl:DatatypeProperty ; rdfs:label "unit"@en .
kwv:measuredAt a owl:DatatypeProperty ; rdfs:label "measured at"@en .
kwv:validFrom a owl:DatatypeProperty ; rdfs:label "valid from"@en .
kwv:validUntil a owl:DatatypeProperty ; rdfs:label "valid until"@en .
kwv:filedOn a owl:DatatypeProperty ; rdfs:label "filed on"@en .
kwv:documentReference a owl:DatatypeProperty ; rdfs:label "document reference"@en .
kwv:meaning a owl:DatatypeProperty ; rdfs:label "meaning"@en .
kwv:jurisdiction a owl:DatatypeProperty ; rdfs:label "jurisdiction"@en .
kwv:address a owl:DatatypeProperty ; rdfs:label "address"@en .

:Worker a owl:Class ;
  rdfs:label "Worker"@en ;
  kwv:keyword "thing" ;
  rdfs:subClassOf obo:BFO_0000040 ;
  obo:IAO_0000115 "A person who works on a job site."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000171 ; owl:someValuesFrom :JobSite ] .

:Electrician a owl:Class ;
  rdfs:label "Electrician"@en ;
  kwv:keyword "role" ;
  rdfs:subClassOf obo:BFO_0000023 ;
  obo:IAO_0000115 "The job a worker does when doing electrical work."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000197 ; owl:someValuesFrom :Worker ] .

:StateLicensingBoard a owl:Class ;
  rdfs:label "State licensing board"@en ;
  kwv:keyword "group" ;
  rdfs:subClassOf obo:BFO_0000027 ;
  obo:IAO_0000115 "The state body that licenses electricians."@en .

:LicensingAuthority a owl:Class ;
  rdfs:label "Licensing authority"@en ;
  kwv:keyword "authority" ;
  rdfs:subClassOf obo:BFO_0000023 ;
  obo:IAO_0000115 "The board's power to grant, suspend, and revoke electrical licenses."@en ;
  rdfs:comment "Authority pattern: a role whose bearer can grant or revoke the statuses named by kwv:canGrant."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty kwv:canGrant ; owl:someValuesFrom :ElectricalLicense ] ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000197 ; owl:someValuesFrom :StateLicensingBoard ] .

:JobSite a owl:Class ;
  rdfs:label "Job site"@en ;
  kwv:keyword "place" ;
  rdfs:subClassOf obo:BFO_0000029 ;
  obo:IAO_0000115 "A commercial site where the work happens."@en .

:NoiseLevel a owl:Class ;
  rdfs:label "Noise level"@en ;
  kwv:keyword "quality" ;
  rdfs:subClassOf obo:BFO_0000019 ;
  obo:IAO_0000115 "A site's sound level, read by meter."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000197 ; owl:someValuesFrom :JobSite ] .

:ElectricalLicense a owl:Class ;
  rdfs:label "Electrical license"@en ;
  kwv:keyword "status" ;
  rdfs:subClassOf obo:BFO_0000031 ;
  obo:IAO_0000115 "The state license that lets a worker do electrical work."@en ;
  rdfs:comment "Recognition pattern: exists because an authority granted it; validity and revocation live here."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty kwv:heldBy ; owl:someValuesFrom :Worker ] .

:InspectionReport a owl:Class ;
  rdfs:label "Inspection report"@en ;
  kwv:keyword "record" ;
  rdfs:subClassOf obo:IAO_0000030 ;
  obo:IAO_0000115 "The report filed after an inspection."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:IAO_0000136 ; owl:someValuesFrom :SiteInspection ] .

:PermitNumber a owl:Class ;
  rdfs:label "Permit number"@en ;
  kwv:keyword "code" ;
  rdfs:subClassOf obo:IAO_0000030 ;
  obo:IAO_0000115 "The city's number for a job's permit."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:IAO_0000219 ; owl:someValuesFrom :JobSite ] .

:DutyToNotifyTheCity a owl:Class ;
  rdfs:label "Duty to notify the city"@en ;
  kwv:keyword "obligation" ;
  rdfs:subClassOf obo:BFO_0000031 ;
  obo:IAO_0000115 "We must tell the city before any excavation."@en ;
  rdfs:comment "Obligation pattern: binds a bearer for a correlate who can claim it."@en .

:SiteInspection a owl:Class ;
  rdfs:label "Site inspection"@en ;
  kwv:keyword "happening" ;
  rdfs:subClassOf obo:BFO_0000015 ;
  obo:IAO_0000115 "A scheduled check of a site's work."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom :Worker ] ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000066 ; owl:someValuesFrom :JobSite ] ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000199 ; owl:someValuesFrom :ContractPeriod ] .

:SafetyIncident a owl:Class ;
  rdfs:label "Safety incident"@en ;
  kwv:keyword "happening" ;
  rdfs:subClassOf obo:BFO_0000015 ;
  obo:IAO_0000115 "Something that went wrong and could hurt someone."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000066 ; owl:someValuesFrom :JobSite ] .

:Excavation a owl:Class ;
  rdfs:label "Excavation"@en ;
  kwv:keyword "happening" ;
  rdfs:subClassOf obo:BFO_0000015 ;
  obo:IAO_0000115 "Digging on a job site."@en ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000066 ; owl:someValuesFrom :JobSite ] ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000199 ; owl:someValuesFrom :ContractPeriod ] .

:ContractPeriod a owl:Class ;
  rdfs:label "Contract period"@en ;
  kwv:keyword "period" ;
  rdfs:subClassOf obo:BFO_0000038 ;
  obo:IAO_0000115 "The time a job's contract covers."@en .


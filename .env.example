# Copy this file to .env and fill in the values

# Flask session encryption — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# OpenAI API key for implication generation and AI suggestions
OPENAI_API_KEY=

# PostgreSQL credentials (used by both the db service and the app)
POSTGRES_USER=owltester
POSTGRES_PASSWORD=
POSTGRES_DB=owl_tester

# Constructed from the above — do not change unless running an external DB
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Optional: path to a custom BFO OWL file inside the container
# BFO_PATH=/app/bfo.owl

# Kindwork module. "Propose answers" runs on each visitor's own OpenAI or
# Anthropic key, entered on the page (the same session-only key "generate
# implications" uses); no server key is used. KINDWORK_LLM_MODEL overrides the
# Claude model. KINDWORK_MODE: triage (public, rate-limited) or full (sign-in).
KINDWORK_MODE=triage
KINDWORK_LLM_MODEL=
KINDWORK_TOKEN=

# Full artifact audit and guided release repair. Both are private and fail
# closed: AUDIT_ALLOWED_USERS and REPAIR_ALLOWED_USERS list the usernames or
# emails allowed in, and empty means NOBODY. Audits always need sign-in and are
# visible only to the account that ran them. The startup log states who may
# audit and who may repair.
AUDIT_ALLOWED_USERS=
REPAIR_ALLOWED_USERS=
REPAIR_RETENTION_DAYS=90
REPAIR_MAX_REMOVED=0.02

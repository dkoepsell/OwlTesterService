# Job site tracker: SHACL shapes generated by Kindwork on 2026-10-18.
# These are the closed-world checks: required links, required values, and date order.

@prefix : <https://example.org/kindwork/job-site-tracker#> .
@prefix kwv: <https://ontology.davidkoepsell.com/kindwork/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

:WorkerShape a sh:NodeShape ;
  sh:targetClass :Worker ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Worker needs a name or reference."@en ] ,
    [ sh:path obo:BFO_0000171 ; sh:class :JobSite ; sh:maxCount 1 ; sh:message "Located at must be a Job site."@en ] .

:ElectricianShape a sh:NodeShape ;
  sh:targetClass :Electrician ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Electrician needs a name or reference."@en ] ,
    [ sh:path obo:BFO_0000197 ; sh:class :Worker ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Held by must be a Worker, and is required."@en ] ,
    [ sh:path kwv:validFrom ; sh:lessThanOrEquals kwv:validUntil ; sh:message "A Electrician can't end before it begins."@en ] .

:StateLicensingBoardShape a sh:NodeShape ;
  sh:targetClass :StateLicensingBoard ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every State licensing board needs a name or reference."@en ] .

:LicensingAuthorityShape a sh:NodeShape ;
  sh:targetClass :LicensingAuthority ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Licensing authority needs a name or reference."@en ] ,
    [ sh:path obo:BFO_0000197 ; sh:class :StateLicensingBoard ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Held by must be a State licensing board, and is required."@en ] .

:JobSiteShape a sh:NodeShape ;
  sh:targetClass :JobSite ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Job site needs a name or reference."@en ] .

:NoiseLevelShape a sh:NodeShape ;
  sh:targetClass :NoiseLevel ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Noise level needs a name or reference."@en ] ,
    [ sh:path obo:BFO_0000197 ; sh:class :JobSite ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Measured on must be a Job site, and is required."@en ] ,
    [ sh:path kwv:hasValue ; sh:minCount 1 ; sh:message "Value is needed for every Noise level."@en ] ,
    [ sh:path kwv:measuredAt ; sh:minCount 1 ; sh:message "Measured at is needed for every Noise level."@en ] .

:ElectricalLicenseShape a sh:NodeShape ;
  sh:targetClass :ElectricalLicense ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Electrical license needs a name or reference."@en ] ,
    [ sh:path kwv:heldBy ; sh:class :Worker ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Held by must be a Worker, and is required."@en ] ,
    [ sh:path kwv:grantedOn ; sh:minCount 1 ; sh:message "Granted on is needed for every Electrical license."@en ] ,
    [ sh:path kwv:standing ; sh:minCount 1 ; sh:message "Standing is needed for every Electrical license."@en ] ,
    [ sh:path kwv:grantedOn ; sh:lessThanOrEquals kwv:expiresOn ; sh:message "A Electrical license can't expire before it is granted."@en ] .

:InspectionReportShape a sh:NodeShape ;
  sh:targetClass :InspectionReport ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Inspection report needs a name or reference."@en ] ,
    [ sh:path obo:IAO_0000136 ; sh:class :SiteInspection ; sh:maxCount 1 ; sh:message "About must be a Site inspection."@en ] .

:PermitNumberShape a sh:NodeShape ;
  sh:targetClass :PermitNumber ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Permit number needs a name or reference."@en ] ,
    [ sh:path obo:IAO_0000219 ; sh:class :JobSite ; sh:maxCount 1 ; sh:message "Labels must be a Job site."@en ] .

:DutyToNotifyTheCityShape a sh:NodeShape ;
  sh:targetClass :DutyToNotifyTheCity ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Duty to notify the city needs a name or reference."@en ] ,
    [ sh:path kwv:standing ; sh:minCount 1 ; sh:message "Standing is needed for every Duty to notify the city."@en ] .

:SiteInspectionShape a sh:NodeShape ;
  sh:targetClass :SiteInspection ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Site inspection needs a name or reference."@en ] ,
    [ sh:path kwv:startsAt ; sh:minCount 1 ; sh:message "Started is needed for every Site inspection."@en ] ,
    [ sh:path obo:BFO_0000057 ; sh:class :Worker ; sh:message "Taking part must be a Worker."@en ] ,
    [ sh:path obo:BFO_0000066 ; sh:class :JobSite ; sh:maxCount 1 ; sh:message "Where must be a Job site."@en ] ,
    [ sh:path obo:BFO_0000199 ; sh:class :ContractPeriod ; sh:maxCount 1 ; sh:message "During must be a Contract period."@en ] ,
    [ sh:path kwv:startsAt ; sh:lessThanOrEquals kwv:endsAt ; sh:message "A Site inspection can't end before it starts."@en ] .

:SafetyIncidentShape a sh:NodeShape ;
  sh:targetClass :SafetyIncident ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Safety incident needs a name or reference."@en ] ,
    [ sh:path kwv:startsAt ; sh:minCount 1 ; sh:message "Started is needed for every Safety incident."@en ] ,
    [ sh:path obo:BFO_0000066 ; sh:class :JobSite ; sh:maxCount 1 ; sh:message "Where must be a Job site."@en ] ,
    [ sh:path kwv:startsAt ; sh:lessThanOrEquals kwv:endsAt ; sh:message "A Safety incident can't end before it starts."@en ] .

:ExcavationShape a sh:NodeShape ;
  sh:targetClass :Excavation ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Excavation needs a name or reference."@en ] ,
    [ sh:path kwv:startsAt ; sh:minCount 1 ; sh:message "Started is needed for every Excavation."@en ] ,
    [ sh:path obo:BFO_0000066 ; sh:class :JobSite ; sh:maxCount 1 ; sh:message "Where must be a Job site."@en ] ,
    [ sh:path obo:BFO_0000199 ; sh:class :ContractPeriod ; sh:maxCount 1 ; sh:message "During must be a Contract period."@en ] ,
    [ sh:path kwv:startsAt ; sh:lessThanOrEquals kwv:endsAt ; sh:message "A Excavation can't end before it starts."@en ] .

:ContractPeriodShape a sh:NodeShape ;
  sh:targetClass :ContractPeriod ;
  sh:property
    [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "Every Contract period needs a name or reference."@en ] ,
    [ sh:path kwv:startsOn ; sh:minCount 1 ; sh:message "Starts is needed for every Contract period."@en ] ,
    [ sh:path kwv:endsOn ; sh:minCount 1 ; sh:message "Ends is needed for every Contract period."@en ] ,
    [ sh:path kwv:startsOn ; sh:lessThanOrEquals kwv:endsOn ; sh:message "A Contract period can't end before it starts."@en ] .


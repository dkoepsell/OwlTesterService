# {{title}}: build, test and release (generated by the OwlTester release builder).
# Requires Java 11+ and make. ROBOT is downloaded on first use unless ROBOT_JAR names a copy.
#   make test                   QC checks: reasoning, SPARQL checks, ROBOT report
#   make release VERSION=x.y.z  write the release files to the repository root

NAME      := {{name}}
BASE      := {{base}}
ONTOLOGY  := {{ontology_iri}}
EDIT      := {{name}}-edit.ttl
CATALOG   := catalog-v001.xml
ROBOT_JAR ?= ../../bin/robot.jar
ROBOT     := java -jar $(ROBOT_JAR)
TMP       := tmp
VERSION   ?= {{version}}

.PHONY: test reason verify report release clean
test: verify report

$(ROBOT_JAR):
	mkdir -p $(dir $(ROBOT_JAR)) && curl -sSL -o $@ https://github.com/ontodev/robot/releases/download/v1.9.6/robot.jar

$(TMP):
	mkdir -p $(TMP)

$(TMP)/merged.owl: $(EDIT) | $(ROBOT_JAR) $(TMP)
	$(ROBOT) merge --catalog $(CATALOG) --input $(EDIT) --output $@

# Consistent, no unsatisfiable classes.
$(TMP)/reasoned.owl: $(TMP)/merged.owl
	$(ROBOT) reason --reasoner HermiT --equivalent-classes-allowed asserted-only --input $< --output $@

reason: $(TMP)/reasoned.owl

# SPARQL checks on the reasoned ontology; any result fails the build.
verify: $(TMP)/reasoned.owl
	$(ROBOT) verify --input $< --queries ../sparql/*-violation.sparql --output-dir $(TMP)

report: $(TMP)/merged.owl
	$(ROBOT) report --input $< --fail-on ERROR --output $(TMP)/report.tsv

# Base: this ontology's own axioms only. Full: merged with imports, reasoned.
release: test
	$(ROBOT) remove --input $(EDIT) --select imports --trim false \
	  annotate --ontology-iri $(BASE)/$(NAME)-base.owl \
	  --version-iri $(BASE)/releases/$(VERSION)/$(NAME)-base.owl \
	  --annotation owl:versionInfo $(VERSION) --output ../../$(NAME)-base.owl
	$(ROBOT) merge --catalog $(CATALOG) --input $(EDIT) \
	  reason --reasoner HermiT --equivalent-classes-allowed asserted-only \
	  annotate --ontology-iri $(ONTOLOGY) \
	  --version-iri $(BASE)/releases/$(VERSION)/$(NAME).owl \
	  --annotation owl:versionInfo $(VERSION) --output ../../$(NAME).owl
	$(ROBOT) convert --input ../../$(NAME).owl --output ../../$(NAME).ttl

clean:
	rm -rf $(TMP)

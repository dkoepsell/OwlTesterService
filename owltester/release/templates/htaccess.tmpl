# Persistent IRIs for https://w3id.org/{{project}}/ (generated by the OwlTester release builder).
# Copy this file to https://github.com/perma-id/w3id.org as {{project}}/.htaccess.
Options +FollowSymLinks
RewriteEngine on

# Versioned files: releases/<version>/<file> resolves to the file at tag v<version>.
RewriteRule ^{{path_prefix}}releases/([0-9][^/]*)/(.+)$ https://raw.githubusercontent.com/{{owner}}/{{repo}}/v$1/$2 [R=302,L]

# The plain ontology IRI resolves to the latest release.
RewriteRule ^{{plain}}$ https://raw.githubusercontent.com/{{owner}}/{{repo}}/main/{{name}}.owl [R=302,L]
RewriteRule ^{{path_prefix}}{{name}}-base\.owl$ https://raw.githubusercontent.com/{{owner}}/{{repo}}/main/{{name}}-base.owl [R=302,L]
RewriteRule ^{{root}}$ https://github.com/{{owner}}/{{repo}} [R=302,L]

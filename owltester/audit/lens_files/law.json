{
  "name": "law",
  "title": "Legal chain (LOF Minimum Legal Chain, Hohfeldian positions, conflicts)",
  "about": "The questions a reviewer asks of a legal ontology. Each row lists candidate terms found by label or SPARQL patterns; nothing is a finding until a reviewer confirms it.",
  "questions": [
    {"id": "source", "group": "chain", "node": "Source of law",
     "question": "Which terms model the instrument or provision a rule comes from?",
     "label_patterns": ["source", "instrument", "provision", "article", "legal ?resource", "act\\b", "established ?in"]},
    {"id": "norm", "group": "chain", "node": "Norm",
     "question": "Which terms model the rule or norm itself?",
     "label_patterns": ["\\brule\\b", "\\bnorm", "requirement", "obligation rule", "legal ?rule"]},
    {"id": "addressee", "group": "chain", "node": "Addressee",
     "question": "Which terms say who a norm binds?",
     "label_patterns": ["addressee", "bearer", "duty ?holder", "subject of", "agent", "role"]},
    {"id": "position", "group": "chain", "node": "Deontic position",
     "question": "Which terms model what the norm makes obligatory, permitted or forbidden?",
     "label_patterns": ["deontic", "obligation", "permission", "prohibition", "modality", "\\bright\\b"]},
    {"id": "conduct", "group": "chain", "node": "Conduct",
     "question": "Which terms model the action a norm is about?",
     "label_patterns": ["action", "conduct", "act(ion|ivity)", "performance", "produces"]},
    {"id": "condition", "group": "chain", "node": "Condition",
     "question": "Which terms model the conditions or triggers under which a norm applies?",
     "label_patterns": ["condition", "trigger", "circumstance", "when", "applicab", "scope"]},
    {"id": "breach", "group": "chain", "node": "Breach",
     "question": "Which terms model a violation of the norm?",
     "label_patterns": ["breach", "violation", "infringement", "non-?compliance", "contravention"]},
    {"id": "remedy", "group": "chain", "node": "Remedy or sanction",
     "question": "Which terms model what follows a breach?",
     "label_patterns": ["remedy", "sanction", "penalty", "fine\\b", "enforcement", "consequence"]},
    {"id": "claim", "group": "hohfeld", "node": "Claim-right and duty",
     "question": "Are claim-rights modeled as correlatives of duties?",
     "label_patterns": ["claim", "duty", "correlative"]},
    {"id": "privilege", "group": "hohfeld", "node": "Privilege and no-right",
     "question": "Are liberties (privileges) distinguished from claim-rights?",
     "label_patterns": ["privilege", "liberty", "no-?right"]},
    {"id": "power", "group": "hohfeld", "node": "Power and liability",
     "question": "Are legal powers (to change positions) and liabilities modeled?",
     "label_patterns": ["power", "liabilit", "competence", "authori[sz]ation"]},
    {"id": "immunity", "group": "hohfeld", "node": "Immunity and disability",
     "question": "Are immunities and disabilities modeled?",
     "label_patterns": ["immunit", "disabilit", "exemption"]},
    {"id": "conflict", "group": "conflict", "node": "Conflict handling",
     "question": "Which terms model derogation, precedence or conflict between norms?",
     "label_patterns": ["derogat", "precedence", "prevail", "lex specialis", "conflict", "overrid", "exception"],
     "sparql": "SELECT DISTINCT ?t WHERE { ?t a <http://www.w3.org/2002/07/owl#ObjectProperty> . ?t <http://www.w3.org/2000/01/rdf-schema#domain> ?d ; <http://www.w3.org/2000/01/rdf-schema#range> ?d . FILTER(regex(str(?t), 'derogat|preval|overrid|except', 'i')) }"},
    {"id": "types-as-individuals", "group": "modeling", "node": "Types modeled as individuals",
     "question": "Are kinds of things (requirement types, categories) modeled as individuals rather than classes?",
     "label_patterns": ["type$", "category$", "kind$"],
     "sparql": "SELECT DISTINCT ?t WHERE { ?t a <http://www.w3.org/2004/02/skos/core#Concept> . FILTER(regex(str(?t), 'type|category|kind', 'i')) }"}
  ]
}

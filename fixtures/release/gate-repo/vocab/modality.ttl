@prefix mod:     <https://w3id.org/audit-mini/modality/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/audit-mini/modality> a owl:Ontology, skos:ConceptScheme ;
    skos:prefLabel "Modality"@en ;
    owl:versionIRI <https://w3id.org/audit-mini/modality/1.0.0> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

mod:Must a skos:Concept ;
    skos:inScheme <https://w3id.org/audit-mini/modality> ;
    skos:prefLabel "must"@en .

mod:May a skos:Concept ;
    skos:inScheme <https://w3id.org/audit-mini/modality> ;
    skos:prefLabel "may"@en .
